#!/usr/bin/env bash
set -u

LABHOSTS=(
    host1.lab.home.arpa
    host2.lab.home.arpa
    host3.lab.home.arpa
)

USER="lab"
PASSWORD="lab"

echo "Populating Ethernet switching tables..."
echo

failed=0

for host in "${LABHOSTS[@]}"; do
    echo "[$host] Running clients-arp..."

    if sshpass -p "$PASSWORD" \
        ssh \
        -o ConnectTimeout=5 \
        -o StrictHostKeyChecking=no \
        -o UserKnownHostsFile=/dev/null \
        "$USER@$host" \
        'clients-arp'
    then
        echo "[$host] OK"
    else
        echo "[$host] FAILED"
        failed=1
    fi

    echo
done

if (( failed )); then
    echo "One or more LabHosts failed."
    exit 1
fi

echo "ARP generation complete."
