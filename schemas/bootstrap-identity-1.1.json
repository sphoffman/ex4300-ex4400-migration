{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/ex-migration/bootstrap-identity-1.1.json",
  "title": "EX4400 bootstrap identity and OOB management binding",
  "type": "object",
  "required": ["schema_version", "identity_id", "migration_id", "approved_at", "bootstrap", "observed", "approval", "eligibility"],
  "properties": {
    "schema_version": {"const": "1.1"},
    "identity_id": {"type": "string", "pattern": "^[0-9a-f]{16}$"},
    "migration_id": {"type": "string", "minLength": 1},
    "approved_at": {"type": "string", "minLength": 1},
    "bootstrap": {
      "type": "object",
      "required": ["profile_id", "profile_digest", "provisioning_mode"],
      "properties": {
        "profile_id": {"type": "string", "minLength": 1},
        "profile_digest": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "provisioning_mode": {"type": "string", "minLength": 1}
      },
      "additionalProperties": false
    },
    "observed": {
      "type": "object",
      "required": ["connection", "oob_management", "device"],
      "properties": {
        "connection": {
          "type": "object",
          "required": ["address", "port", "ssh_host_key_sha256"],
          "properties": {
            "address": {"type": "string", "minLength": 1},
            "port": {"type": "integer", "minimum": 1, "maximum": 65535},
            "ssh_host_key_sha256": {"type": "string", "pattern": "^SHA256:[A-Za-z0-9+/]+$"}
          },
          "additionalProperties": false
        },
        "oob_management": {
          "type": "object",
          "required": ["address", "routing_instance", "default_gateway", "gateway_source"],
          "properties": {
            "address": {"type": "string", "minLength": 1},
            "routing_instance": {"const": "mgmt_junos"},
            "default_gateway": {"type": "string", "minLength": 1},
            "gateway_source": {"const": "observed-configured-mgmt_junos-default"}
          },
          "additionalProperties": false
        },
        "device": {
          "type": "object",
          "required": ["hostname", "model", "serial_number", "members"],
          "properties": {
            "hostname": {"type": "string", "minLength": 1},
            "model": {"type": "string", "minLength": 1},
            "serial_number": {"type": "string", "minLength": 1},
            "members": {
              "type": "array",
              "minItems": 1,
              "items": {
                "type": "object",
                "required": ["member_id", "status", "serial_number", "model"],
                "properties": {
                  "member_id": {"type": "integer", "minimum": 0},
                  "status": {"type": "string", "minLength": 1},
                  "serial_number": {"type": "string", "minLength": 1},
                  "model": {"type": "string", "minLength": 1}
                },
                "additionalProperties": false
              }
            }
          },
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    },
    "approval": {
      "type": "object",
      "required": ["method", "approved"],
      "properties": {
        "method": {"const": "interactive-operator-binding"},
        "approved": {"const": true}
      },
      "additionalProperties": false
    },
    "eligibility": {
      "type": "object",
      "required": ["status", "production_eligible", "reason"],
      "properties": {
        "status": {"enum": ["LAB_ONLY", "PRODUCTION_ELIGIBLE"]},
        "production_eligible": {"type": "boolean"},
        "reason": {"type": "string", "minLength": 1}
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
