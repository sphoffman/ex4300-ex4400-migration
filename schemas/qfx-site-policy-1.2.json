{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/ex-migration/qfx-site-policy-1.2.json",
  "title": "Generated QFX migration site policy",
  "type": "object",
  "required": [
    "schema_version",
    "site_policy_id",
    "site_id",
    "environment",
    "production_eligible",
    "qfx_pair",
    "stage_port_pools",
    "excluded_interfaces",
    "ae_pool",
    "management_vlan",
    "temporary_recovery_vlan",
    "prestage_access_vlan",
    "precutover_qfx_baseline",
    "esi",
    "validation",
    "source_site_inventory"
  ],
  "properties": {
    "schema_version": {"const": "1.2"},
    "site_policy_id": {"type": "string", "minLength": 1},
    "site_id": {"type": "string", "minLength": 1},
    "environment": {"enum": ["lab", "production"]},
    "production_eligible": {"type": "boolean"},
    "qfx_pair": {
      "type": "array",
      "minItems": 2,
      "maxItems": 2,
      "items": {
        "type": "object",
        "required": ["role", "management_address", "expected_hostname", "expected_model"],
        "properties": {
          "role": {"enum": ["qfx-a", "qfx-b"]},
          "management_address": {"type": "string", "minLength": 1},
          "expected_hostname": {"type": "string", "minLength": 1},
          "expected_model": {"type": "string", "minLength": 1}
        },
        "additionalProperties": false
      }
    },
    "stage_port_pools": {
      "type": "object",
      "minProperties": 1,
      "additionalProperties": {
        "type": "array",
        "minItems": 1,
        "uniqueItems": true,
        "items": {"type": "string", "pattern": "^et-[0-9]+/[0-9]+/[0-9]+$"}
      }
    },
    "excluded_interfaces": {
      "type": "array",
      "uniqueItems": true,
      "items": {"type": "string"}
    },
    "ae_pool": {
      "type": "object",
      "required": ["method", "ae_min", "ae_max", "migration_assignment_prebound"],
      "properties": {
        "method": {"const": "discover-from-existing-qfx-config"},
        "ae_min": {"type": "integer", "minimum": 0, "maximum": 127},
        "ae_max": {"type": "integer", "minimum": 0, "maximum": 127},
        "migration_assignment_prebound": {"const": false}
      },
      "additionalProperties": false
    },
    "management_vlan": {"$ref": "#/$defs/vlan"},
    "temporary_recovery_vlan": {"$ref": "#/$defs/vlan"},
    "prestage_access_vlan": {"$ref": "#/$defs/vlan"},
    "precutover_qfx_baseline": {
      "type": "object",
      "required": ["required_vlan_ids", "lacp_mode", "force_up"],
      "properties": {
        "required_vlan_ids": {
          "type": "array",
          "minItems": 2,
          "maxItems": 2,
          "uniqueItems": true,
          "items": {"type": "integer", "minimum": 1, "maximum": 4094}
        },
        "lacp_mode": {"const": "active"},
        "force_up": {"const": false}
      },
      "additionalProperties": false
    },
    "esi": {
      "type": "object",
      "required": ["method", "all_active"],
      "properties": {
        "method": {"const": "auto-derive-type-1-lacp"},
        "all_active": {"const": true}
      },
      "additionalProperties": false
    },
    "validation": {
      "type": "object",
      "required": [
        "attachment_discovered_post_cutover",
        "require_interface_symmetry",
        "require_lldp",
        "require_lacp_partner",
        "require_matching_ae",
        "require_matching_lacp_system_id",
        "operator_supplied_ports_allowed"
      ],
      "properties": {
        "attachment_discovered_post_cutover": {"const": true},
        "require_interface_symmetry": {"const": true},
        "require_lldp": {"const": true},
        "require_lacp_partner": {"const": true},
        "require_matching_ae": {"const": true},
        "require_matching_lacp_system_id": {"const": true},
        "operator_supplied_ports_allowed": {"const": false}
      },
      "additionalProperties": false
    },
    "source_site_inventory": {
      "type": "object",
      "required": ["inventory_id", "inventory_digest", "path"],
      "properties": {
        "inventory_id": {"type": "string", "minLength": 1},
        "inventory_digest": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "path": {"type": "string", "minLength": 1}
      },
      "additionalProperties": false
    }
  },
  "allOf": [
    {
      "if": {"properties": {"environment": {"const": "lab"}}, "required": ["environment"]},
      "then": {"properties": {"production_eligible": {"const": false}}}
    },
    {
      "if": {"properties": {"environment": {"const": "production"}}, "required": ["environment"]},
      "then": {"properties": {"production_eligible": {"const": true}}}
    }
  ],
  "$defs": {
    "vlan": {
      "type": "object",
      "required": ["name", "vlan_id"],
      "properties": {
        "name": {"type": "string", "minLength": 1},
        "vlan_id": {"type": "integer", "minimum": 1, "maximum": 4094}
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
