{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/ex-migration/render-manifest-1.0.json",
  "title": "Deterministic EX4400 configuration render",
  "type": "object",
  "required": ["schema_version", "render_id", "migration_id", "package_id", "created_at", "phase", "inputs", "artifacts", "validation", "safety"],
  "properties": {
    "schema_version": {"const": "1.0"},
    "render_id": {"type": "string", "pattern": "^[0-9a-f]{16}$"},
    "migration_id": {"type": "string", "minLength": 1},
    "package_id": {"type": "string", "pattern": "^[0-9a-f]{16}$"},
    "created_at": {"type": "string", "format": "date-time"},
    "phase": {"const": "pre_stage"},
    "inputs": {
      "type": "object",
      "required": ["package_digest", "template_digest", "template_contract_digest", "renderer_version"],
      "properties": {
        "package_digest": {"$ref": "#/$defs/digest"},
        "template_digest": {"$ref": "#/$defs/digest"},
        "template_contract_digest": {"$ref": "#/$defs/digest"},
        "renderer_version": {"type": "string", "minLength": 1}
      },
      "additionalProperties": false
    },
    "artifacts": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["path", "sha256"],
        "properties": {
          "path": {"const": "ex4400-pre-stage.set"},
          "sha256": {"$ref": "#/$defs/digest"}
        },
        "additionalProperties": false
      }
    },
    "validation": {
      "type": "object",
      "required": ["result", "checks"],
      "properties": {
        "result": {"const": "PASS"},
        "checks": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1}}
      },
      "additionalProperties": false
    },
    "safety": {
      "type": "object",
      "required": ["device_connections_allowed", "device_writes_allowed"],
      "properties": {
        "device_connections_allowed": {"const": false},
        "device_writes_allowed": {"const": false}
      },
      "additionalProperties": false
    }
  },
  "$defs": {"digest": {"type": "string", "pattern": "^[0-9a-f]{64}$"}},
  "additionalProperties": false
}
