{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/ex-migration/qfx-attachment-1.0.json",
  "title": "Approved post-cutover QFX attachment discovery",
  "type": "object",
  "required": [
    "schema_version", "attachment_id", "migration_id", "observed_at", "approved_at",
    "plan", "site_policy", "expected_ex_hostname", "devices", "pair_checks",
    "result", "approval", "safety"
  ],
  "properties": {
    "schema_version": {"const": "1.0"},
    "attachment_id": {"type": "string", "pattern": "^[0-9a-f]{16}$"},
    "migration_id": {"type": "string", "pattern": "^[A-Za-z0-9_.-]+$"},
    "observed_at": {"type": "string", "format": "date-time"},
    "approved_at": {"type": "string", "format": "date-time"},
    "plan": {
      "type": "object",
      "required": ["plan_id", "plan_digest"],
      "properties": {
        "plan_id": {"type": "string", "minLength": 1},
        "plan_digest": {"$ref": "#/$defs/digest"}
      },
      "additionalProperties": false
    },
    "site_policy": {
      "type": "object",
      "required": ["site_policy_id", "site_policy_digest"],
      "properties": {
        "site_policy_id": {"type": "string", "minLength": 1},
        "site_policy_digest": {"$ref": "#/$defs/digest"}
      },
      "additionalProperties": false
    },
    "expected_ex_hostname": {"type": "string", "minLength": 1},
    "devices": {
      "type": "array",
      "minItems": 2,
      "maxItems": 2,
      "items": {
        "type": "object",
        "required": [
          "role", "management_address", "ssh_host_key_sha256", "expected_qfx_hostname",
          "expected_qfx_model", "observed_qfx_hostname", "observed_qfx_model",
          "expected_ex_hostname", "lldp_match_count", "physical_interface",
          "remote_port_id", "ae_interface", "lacp_system_id", "baseline_vlan_ids",
          "unresolved_vlan_members", "checks", "result"
        ],
        "properties": {
          "role": {"enum": ["qfx-a", "qfx-b"]},
          "management_address": {"type": "string"},
          "ssh_host_key_sha256": {"type": "string", "pattern": "^SHA256:"},
          "expected_qfx_hostname": {"type": "string"},
          "expected_qfx_model": {"type": "string"},
          "observed_qfx_hostname": {"type": "string"},
          "observed_qfx_model": {"type": "string"},
          "expected_ex_hostname": {"type": "string"},
          "lldp_match_count": {"const": 1},
          "physical_interface": {"type": "string", "pattern": "^et-[0-9]+/[0-9]+/[0-9]+$"},
          "remote_port_id": {"type": ["string", "null"]},
          "ae_interface": {"type": "string", "pattern": "^ae[0-9]+$"},
          "lacp_system_id": {"type": "string", "pattern": "^([0-9a-f]{2}:){5}[0-9a-f]{2}$"},
          "baseline_vlan_ids": {
            "type": "array", "minItems": 2, "uniqueItems": true,
            "items": {"type": "integer", "minimum": 1, "maximum": 4094}
          },
          "unresolved_vlan_members": {"type": "array", "maxItems": 0},
          "checks": {
            "type": "object",
            "minProperties": 1,
            "additionalProperties": {"const": true}
          },
          "result": {"const": "PASS"}
        },
        "additionalProperties": false
      }
    },
    "pair_checks": {
      "type": "object",
      "required": [
        "same_target_ex_hostname", "physical_interface_symmetry", "ae_symmetry",
        "lacp_system_id_symmetry"
      ],
      "properties": {
        "same_target_ex_hostname": {"const": true},
        "physical_interface_symmetry": {"const": true},
        "ae_symmetry": {"const": true},
        "lacp_system_id_symmetry": {"const": true}
      },
      "additionalProperties": false
    },
    "result": {"const": "PASS"},
    "approval": {
      "type": "object",
      "required": ["approved", "method", "scope"],
      "properties": {
        "approved": {"const": true},
        "method": {"const": "interactive-operator-binding"},
        "scope": {"const": "observed-post-cutover-qfx-attachment"}
      },
      "additionalProperties": false
    },
    "safety": {
      "type": "object",
      "required": [
        "qfx_writes_authorized", "ex4400_writes_authorized",
        "operator_supplied_ports_used", "force_up_allowed"
      ],
      "properties": {
        "qfx_writes_authorized": {"const": false},
        "ex4400_writes_authorized": {"const": false},
        "operator_supplied_ports_used": {"const": false},
        "force_up_allowed": {"const": false}
      },
      "additionalProperties": false
    }
  },
  "$defs": {
    "digest": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
  },
  "additionalProperties": false
}
