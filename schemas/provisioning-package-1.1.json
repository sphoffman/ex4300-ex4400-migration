{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/ex-migration/provisioning-package-1.1.json",
  "title": "Digest-bound EX4400 pre-cutover provisioning package",
  "type": "object",
  "required": ["schema_version", "package_id", "migration_id", "created_at", "inputs", "eligibility", "provisioning_mode", "variables", "phases", "artifacts", "validation", "safety"],
  "properties": {
    "schema_version": {"const": "1.1"},
    "package_id": {"type": "string", "pattern": "^[0-9a-f]{16}$"},
    "migration_id": {"type": "string", "pattern": "^[A-Za-z0-9_.-]+$"},
    "created_at": {"type": "string", "format": "date-time"},
    "inputs": {
      "type": "object",
      "required": ["plan_digest", "plan_approval_digest", "template_digest", "template_contract_digest", "site_policy_digest", "bootstrap_profile_digest", "settings_digest", "renderer_version"],
      "properties": {
        "plan_digest": {"$ref": "#/$defs/digest"},
        "plan_approval_digest": {"$ref": "#/$defs/digest"},
        "template_digest": {"$ref": "#/$defs/digest"},
        "template_contract_digest": {"$ref": "#/$defs/digest"},
        "site_policy_digest": {"$ref": "#/$defs/digest"},
        "bootstrap_profile_digest": {"$ref": "#/$defs/digest"},
        "settings_digest": {"$ref": "#/$defs/digest"},
        "renderer_version": {"type": "string", "minLength": 1}
      },
      "additionalProperties": false
    },
    "eligibility": {
      "type": "object",
      "required": ["status", "production_eligible", "reasons"],
      "properties": {
        "status": {"enum": ["PRODUCTION_ELIGIBLE", "LAB_ONLY"]},
        "production_eligible": {"type": "boolean"},
        "reasons": {"type": "array", "items": {"type": "string"}}
      },
      "additionalProperties": false
    },
    "provisioning_mode": {"enum": ["local-fxp0-mac", "asserted", "in-place-lab"]},
    "variables": {"type": "object"},
    "phases": {
      "type": "object",
      "required": ["pre_stage", "cutover", "post_move"],
      "properties": {
        "pre_stage": {
          "type": "object",
          "required": ["status", "qfx_attachment_known", "qfx_connections_performed", "device_writes_authorized"],
          "properties": {
            "status": {"const": "INPUTS_VALIDATED"},
            "qfx_attachment_known": {"const": false},
            "qfx_connections_performed": {"const": false},
            "device_writes_authorized": {"const": false}
          },
          "additionalProperties": false
        },
        "cutover": {
          "type": "object",
          "required": ["status", "qfx_attachment_discovery_required", "device_writes_authorized"],
          "properties": {
            "status": {"const": "NOT_AUTHORIZED"},
            "qfx_attachment_discovery_required": {"const": true},
            "device_writes_authorized": {"const": false}
          },
          "additionalProperties": false
        },
        "post_move": {
          "type": "object",
          "required": ["status", "qfx_attachment_discovery_required", "device_writes_authorized"],
          "properties": {
            "status": {"const": "NOT_AUTHORIZED"},
            "qfx_attachment_discovery_required": {"const": true},
            "device_writes_authorized": {"const": false}
          },
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    },
    "artifacts": {"type": "array", "maxItems": 0},
    "validation": {
      "type": "object",
      "required": ["result", "checks"],
      "properties": {
        "result": {"const": "PASS"},
        "checks": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1}}
      },
      "additionalProperties": false
    },
    "safety": {
      "type": "object",
      "required": ["rendering_allowed", "device_connections_allowed", "device_writes_allowed", "qfx_connections_allowed", "qfx_attachment_prebound", "stale_if_any_input_digest_changes"],
      "properties": {
        "rendering_allowed": {"const": true},
        "device_connections_allowed": {"const": false},
        "device_writes_allowed": {"const": false},
        "qfx_connections_allowed": {"const": false},
        "qfx_attachment_prebound": {"const": false},
        "stale_if_any_input_digest_changes": {"const": true}
      },
      "additionalProperties": false
    }
  },
  "allOf": [
    {
      "if": {"properties": {"provisioning_mode": {"enum": ["asserted", "in-place-lab"]}}, "required": ["provisioning_mode"]},
      "then": {"properties": {"eligibility": {"properties": {"status": {"const": "LAB_ONLY"}, "production_eligible": {"const": false}}, "required": ["status", "production_eligible"]}}}
    }
  ],
  "$defs": {"digest": {"type": "string", "pattern": "^[0-9a-f]{64}$"}},
  "additionalProperties": false
}
