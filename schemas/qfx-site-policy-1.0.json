{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/ex-migration/qfx-site-policy-1.0.json",
  "title": "QFX migration site policy",
  "type": "object",
  "required": ["schema_version", "site_policy_id", "environment", "production_eligible", "qfx_pair", "stage_port_pools", "excluded_interfaces", "management_vlan", "voice_vlan", "temporary_recovery_vlan", "port_to_ae", "esi", "lacp_system_id", "validation"],
  "properties": {
    "schema_version": {"const": "1.0"},
    "site_policy_id": {"type": "string", "minLength": 1},
    "environment": {"enum": ["production", "lab"]},
    "production_eligible": {"type": "boolean"},
    "qfx_pair": {
      "type": "array",
      "minItems": 2,
      "maxItems": 2,
      "items": {
        "type": "object",
        "required": ["role", "management_address", "expected_hostname", "expected_model"],
        "properties": {
          "role": {"enum": ["qfx-a", "qfx-b"]},
          "management_address": {"type": "string", "pattern": "^[0-9]{1,3}(\\.[0-9]{1,3}){3}$"},
          "expected_hostname": {"type": "string", "minLength": 1},
          "expected_model": {"type": "string", "minLength": 1}
        },
        "additionalProperties": false
      }
    },
    "stage_port_pools": {
      "type": "object",
      "minProperties": 1,
      "additionalProperties": {
        "type": "array",
        "minItems": 1,
        "uniqueItems": true,
        "items": {"type": "string", "pattern": "^et-[0-9]+/[0-9]+/[0-9]+$"}
      }
    },
    "excluded_interfaces": {
      "type": "array",
      "uniqueItems": true,
      "items": {"type": "string"}
    },
    "management_vlan": {"$ref": "#/$defs/vlan"},
    "voice_vlan": {"$ref": "#/$defs/vlan"},
    "temporary_recovery_vlan": {"$ref": "#/$defs/vlan"},
    "port_to_ae": {
      "type": "object",
      "required": ["method", "ae_min", "ae_max", "assignments"],
      "properties": {
        "method": {"const": "explicit-migration-id-map"},
        "ae_min": {"type": "integer", "minimum": 0},
        "ae_max": {"type": "integer", "minimum": 0},
        "assignments": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "object",
            "required": ["migration_id", "physical_interface", "ae_interface"],
            "properties": {
              "migration_id": {"type": "string", "minLength": 1},
              "physical_interface": {"type": "string", "pattern": "^et-[0-9]+/[0-9]+/[0-9]+$"},
              "ae_interface": {"type": "string", "pattern": "^ae[0-9]+$"}
            },
            "additionalProperties": false
          }
        }
      },
      "additionalProperties": false
    },
    "esi": {
      "type": "object",
      "required": ["method", "all_active"],
      "properties": {
        "method": {"const": "auto-derive-type-1-lacp"},
        "all_active": {"const": true}
      },
      "additionalProperties": false
    },
    "lacp_system_id": {
      "type": "object",
      "required": ["method", "values"],
      "properties": {
        "method": {"const": "explicit-per-ae"},
        "values": {
          "type": "object",
          "minProperties": 1,
          "patternProperties": {
            "^ae[0-9]+$": {"type": "string", "pattern": "^([0-9a-f]{2}:){5}[0-9a-f]{2}$"}
          },
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    },
    "validation": {
      "type": "object",
      "required": ["require_interface_symmetry", "require_lldp", "require_lacp_partner", "require_matching_lacp_system_id", "operator_supplied_ports_allowed"],
      "properties": {
        "require_interface_symmetry": {"const": true},
        "require_lldp": {"const": true},
        "require_lacp_partner": {"const": true},
        "require_matching_lacp_system_id": {"const": true},
        "operator_supplied_ports_allowed": {"const": false}
      },
      "additionalProperties": false
    }
  },
  "allOf": [
    {
      "if": {"properties": {"environment": {"const": "lab"}}, "required": ["environment"]},
      "then": {"properties": {"production_eligible": {"const": false}}}
    },
    {
      "if": {"properties": {"environment": {"const": "production"}}, "required": ["environment"]},
      "then": {
        "properties": {
          "qfx_pair": {
            "items": {
              "properties": {"expected_model": {"const": "QFX5700"}},
              "required": ["expected_model"]
            }
          }
        }
      }
    }
  ],
  "$defs": {
    "vlan": {
      "type": "object",
      "required": ["name", "vlan_id"],
      "properties": {
        "name": {"type": "string", "minLength": 1},
        "vlan_id": {"type": "integer", "minimum": 1, "maximum": 4094}
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
