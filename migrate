#!/usr/bin/env bash
set -euo pipefail

ROOT="$(CDPATH= cd -- "$(dirname -- "$0")" && pwd)"
cd "$ROOT"

args=("$@")
docker_env=(--env PYTHONPATH=/scripts/src)
module="ex_migration_operator.cli"

# Initial old-switch discovery intentionally has no migration ID. The discovery
# collector derives it from the observed hostname and reports the ID to use for
# all subsequent operator commands.
initial_discovery=0
if [[ ${#args[@]} -ge 1 ]]; then
  case "${args[0]}" in
    site-init|site-discover|site-stage|site-status)
      module="ex_migration_site.cli"
      ;;
    discover)
      module="ex_migration_discovery.cli"
      initial_discovery=1
      args=("collect" "${args[@]:1}")
      ;;
    status|analyze|build|prestage|cutover-ready|cutover|activate|validate|finalize|mac)
      echo "ERROR: '${args[0]}' is a migration command, not a migration ID." >&2
      echo "Use: ./migrate <migration-id> ${args[0]}" >&2
      if [[ "${args[0]}" == "status" ]]; then
        echo "For site readiness, use: ./migrate site-status" >&2
      fi
      exit 2
      ;;
  esac
fi

# Discovery credentials are session-only. For an initial discovery this avoids
# making the operator invent a migration ID first. For repeated per-migration
# discovery, the same mechanism lets independent collections reuse credentials
# within the invocation without writing the password to disk or argv.
discovery_session=0
option_start=0
if (( initial_discovery == 1 )); then
  discovery_session=1
  option_start=1
elif [[ "$module" == "ex_migration_operator.cli" && ${#args[@]} -ge 2 && "${args[1]}" == "discover" ]]; then
  discovery_session=1
  option_start=2
fi

if (( discovery_session == 1 )); then
  have_username=0
  password_env_name=""
  i=$option_start
  while (( i < ${#args[@]} )); do
    case "${args[$i]}" in
      --username)
        have_username=1
        ((i += 2))
        continue
        ;;
      --username=*)
        have_username=1
        ;;
      --password-env)
        if (( i + 1 < ${#args[@]} )); then
          password_env_name="${args[$((i + 1))]}"
          ((i += 2))
          continue
        fi
        ;;
      --password-env=*)
        password_env_name="${args[$i]#--password-env=}"
        ;;
    esac
    ((i += 1))
  done

  if (( have_username == 0 )); then
    read -r -p "Username: " discovery_username
    if [[ -z "$discovery_username" ]]; then
      echo "ERROR: username must not be empty" >&2
      exit 2
    fi
    args+=(--username "$discovery_username")
  fi

  if [[ -z "$password_env_name" ]]; then
    read -r -s -p "Password: " discovery_password
    printf '\n'
    export EX_MIGRATION_DISCOVERY_PASSWORD="$discovery_password"
    unset discovery_password
    password_env_name="EX_MIGRATION_DISCOVERY_PASSWORD"
    args+=(--password-env "$password_env_name")
  fi

  # With --env NAME (no '=value'), Docker copies NAME from this process's
  # environment. For an operator-supplied --password-env this also makes the
  # host variable available inside the PyEZ container.
  docker_env+=(--env "$password_env_name")
fi

exec docker run --rm -it \
  --entrypoint python \
  --workdir /scripts \
  "${docker_env[@]}" \
  -v "$ROOT:/scripts" \
  juniper/pyez \
  -m "$module" "${args[@]}"
