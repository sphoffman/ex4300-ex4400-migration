#!/usr/bin/env bash
set -euo pipefail

ROOT="$(CDPATH= cd -- "$(dirname -- "$0")" && pwd)"
cd "$ROOT"

args=("$@")
docker_env=(--env PYTHONPATH=/scripts/src)
operator_module="ex_migration_operator.policy_cli"
module="$operator_module"

# Initial old-switch discovery intentionally has no migration ID. The wrapper
# derives it from the observed hostname, then asserts that same ID for any
# additional collections requested with --count.
initial_discovery=0
if [[ ${#args[@]} -ge 1 ]]; then
  case "${args[0]}" in
    site-init|site-prep)
      module="$operator_module"
      ;;
    site-discover|site-stage|site-status)
      module="ex_migration_site.cli"
      ;;
    discover)
      module="ex_migration_operator.initial_discovery"
      initial_discovery=1
      args=("${args[@]:1}")
      ;;
    status|analyze|build|prestage|cutover-ready|cutover|activate|validate|finalize|mac)
      echo "ERROR: '${args[0]}' is a migration command, not a migration ID." >&2
      echo "Use: ./migrate <migration-id> ${args[0]}" >&2
      if [[ "${args[0]}" == "status" ]]; then
        echo "For site readiness, use: ./migrate site-status" >&2
      fi
      exit 2
      ;;
  esac
fi

# A bare per-migration resume must not offer a phase that depends on the QFX
# site policy until site discovery/baseline validation has generated the active
# policy. Route the operator to site-status first so the missing prerequisite is
# obvious and actionable rather than failing later inside prestage.
if [[ "$module" == "$operator_module" && ${#args[@]} -eq 1 && "${args[0]}" != "site-init" && "${args[0]}" != "site-prep" ]]; then
  if [[ ! -f config/qfx-site-policy.active.json ]]; then
    echo "Migration '${args[0]}' is waiting on site readiness."
    echo "Complete the site prerequisite before continuing this migration."
    echo
    module="ex_migration_site.cli"
    args=("site-status")
  fi
fi

# Discovery credentials are session-only. For initial discovery the wrapper can
# launch several immutable collections while reusing one credential prompt.
discovery_session=0
option_start=0
if (( initial_discovery == 1 )); then
  discovery_session=1
  option_start=0
elif [[ "$module" == "$operator_module" && ${#args[@]} -ge 2 && "${args[1]}" == "discover" ]]; then
  discovery_session=1
  option_start=2
fi

# Help must be side-effect free. Let argparse render help without prompting for
# discovery credentials or touching credential environment variables.
help_requested=0
for arg in "${args[@]}"; do
  if [[ "$arg" == "-h" || "$arg" == "--help" ]]; then
    help_requested=1
    break
  fi
done

if (( discovery_session == 1 && help_requested == 0 )); then
  have_username=0
  password_env_name=""
  i=$option_start
  while (( i < ${#args[@]} )); do
    case "${args[$i]}" in
      --username)
        have_username=1
        ((i += 2))
        continue
        ;;
      --username=*)
        have_username=1
        ;;
      --password-env)
        if (( i + 1 < ${#args[@]} )); then
          password_env_name="${args[$((i + 1))]}"
          ((i += 2))
          continue
        fi
        ;;
      --password-env=*)
        password_env_name="${args[$i]#--password-env=}"
        ;;
    esac
    ((i += 1))
  done

  if (( have_username == 0 )); then
    read -r -p "Username: " discovery_username
    if [[ -z "$discovery_username" ]]; then
      echo "ERROR: username must not be empty" >&2
      exit 2
    fi
    args+=(--username "$discovery_username")
  fi

  if [[ -z "$password_env_name" ]]; then
    read -r -s -p "Password: " discovery_password
    printf '\n'
    export EX_MIGRATION_DISCOVERY_PASSWORD="$discovery_password"
    unset discovery_password
    password_env_name="EX_MIGRATION_DISCOVERY_PASSWORD"
    args+=(--password-env "$password_env_name")
  fi

  docker_env+=(--env "$password_env_name")
fi

# Preserve host ownership on bind-mounted artifacts. Without an explicit user,
# the juniper/pyez container runs as root and creates root-owned snapshots/config
# files in the repository. Running with the invoking user's numeric UID/GID keeps
# all generated artifacts owned by the operator on the host filesystem.
host_uid="$(id -u)"
host_gid="$(id -g)"

exec docker run --rm -it \
  --user "${host_uid}:${host_gid}" \
  --entrypoint python \
  --workdir /scripts \
  "${docker_env[@]}" \
  -v "$ROOT:/scripts" \
  juniper/pyez \
  -m "$module" "${args[@]}"
