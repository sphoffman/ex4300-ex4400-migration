#!/usr/bin/env bash
set -euo pipefail

ROOT="$(CDPATH= cd -- "$(dirname -- "$0")" && pwd)"
cd "$ROOT"

args=("$@")
docker_env=(--env PYTHONPATH=/scripts/src)
module="ex_migration_operator.cli"

if [[ ${#args[@]} -ge 1 ]]; then
  case "${args[0]}" in
    site-init|site-discover|site-stage|site-status)
      module="ex_migration_site.cli"
      ;;
  esac
fi

# A repeated per-migration discovery session launches one Python child per
# immutable collection. Prompt once here, then forward the password through an
# ephemeral environment variable so every child can reuse it without putting the
# secret on its command line or writing it to disk.
if [[ "$module" == "ex_migration_operator.cli" && ${#args[@]} -ge 2 && "${args[1]}" == "discover" ]]; then
  have_username=0
  password_env_name=""
  i=2
  while (( i < ${#args[@]} )); do
    case "${args[$i]}" in
      --username)
        have_username=1
        ((i += 2))
        continue
        ;;
      --username=*)
        have_username=1
        ;;
      --password-env)
        if (( i + 1 < ${#args[@]} )); then
          password_env_name="${args[$((i + 1))]}"
          ((i += 2))
          continue
        fi
        ;;
      --password-env=*)
        password_env_name="${args[$i]#--password-env=}"
        ;;
    esac
    ((i += 1))
  done

  if (( have_username == 0 )); then
    read -r -p "Username: " discovery_username
    if [[ -z "$discovery_username" ]]; then
      echo "ERROR: username must not be empty" >&2
      exit 2
    fi
    args+=(--username "$discovery_username")
  fi

  if [[ -z "$password_env_name" ]]; then
    read -r -s -p "Password: " discovery_password
    printf '\n'
    export EX_MIGRATION_DISCOVERY_PASSWORD="$discovery_password"
    unset discovery_password
    password_env_name="EX_MIGRATION_DISCOVERY_PASSWORD"
    args+=(--password-env "$password_env_name")
  fi

  # With --env NAME (no '=value'), Docker copies NAME from this process's
  # environment. For an operator-supplied --password-env this also makes the
  # host variable available inside the PyEZ container.
  docker_env+=(--env "$password_env_name")
fi

exec docker run --rm -it \
  --entrypoint python \
  --workdir /scripts \
  "${docker_env[@]}" \
  -v "$ROOT:/scripts" \
  juniper/pyez \
  -m "$module" "${args[@]}"
